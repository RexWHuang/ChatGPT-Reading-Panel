{
  "manifest_version": 3,
  "name": "对话阅读面板",
  "description": "打开聊天即显示提问目录，支持跳转、返回和本地缓存。",
  "version": "1.4.0",
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "conversation.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "recent.js"
      ],
      "css": [
        "recent.css"
      ],
      "world": "MAIN"
    },
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "outline.js"
      ],
      "run_at": "document_end"
    }
  ],
  "permissions": [
    "storage"
  ]
}
