{
  "manifest_version": 3,
  "name": "对话阅读面板",
  "description": "悬停查看对话时间，按需打开当前聊天的提问目录。",
  "version": "1.3.0",
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "recent.js"
      ],
      "css": [
        "recent.css"
      ],
      "world": "MAIN"
    },
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "outline.js"
      ]
    }
  ],
  "permissions": [
    "storage"
  ]
}
